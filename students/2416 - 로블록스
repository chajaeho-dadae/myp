<!DOCTYPE html>
<html lang="ko">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
 <title>Classic Roblox Style 3D Obby</title>
 <style>
   * {
     box-sizing: border-box;
     margin: 0;
     padding: 0;
     user-select: none;
     -webkit-user-select: none;
     font-family: 'Fredoka', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
   }
   body, html {
     width: 100%;
     height: 100%;
     overflow: hidden;
     background-color: #0c101d;
     color: #fff;
   }
   #canvas-container {
     width: 100%;
     height: 100%;
     position: absolute;
     top: 0;
     left: 0;
     z-index: 1;
   }


   /* UI Overlay */
   #ui-overlay {
     position: absolute;
     top: 0;
     left: 0;
     width: 100%;
     height: 100%;
     z-index: 10;
     pointer-events: none;
     display: flex;
     flex-direction: column;
     justify-content: space-between;
     padding: 16px;
   }
   .interactive { pointer-events: auto; }


   /* Top HUD */
   .hud-top {
     display: flex;
     justify-content: space-between;
     align-items: flex-start;
     width: 100%;
   }
   .badge-card {
     background: rgba(15, 23, 42, 0.85);
     border: 2px solid rgba(255, 255, 255, 0.15);
     backdrop-filter: blur(12px);
     padding: 10px 18px;
     border-radius: 16px;
     box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
     display: flex;
     align-items: center;
     gap: 12px;
   }
   .badge-title {
     font-size: 0.75rem;
     color: #94a3b8;
     text-transform: uppercase;
     letter-spacing: 1px;
     font-weight: 700;
   }
   .badge-value {
     font-size: 1.3rem;
     font-weight: 800;
     color: #38bdf8;
   }


   /* Action Buttons Top Right */
   .btn-group {
     display: flex;
     gap: 10px;
   }
   .hud-btn {
     background: rgba(30, 41, 59, 0.9);
     border: 2px solid #38bdf8;
     color: #fff;
     padding: 10px 16px;
     border-radius: 14px;
     font-weight: 700;
     cursor: pointer;
     transition: all 0.2s ease;
     display: flex;
     align-items: center;
     gap: 6px;
     box-shadow: 0 4px 14px rgba(56, 189, 248, 0.25);
   }
   .hud-btn:hover {
     transform: translateY(-2px);
     background: #38bdf8;
     color: #0f172a;
   }


   /* Mobile/Touch Jump Button */
   #jump-btn {
     position: absolute;
     bottom: 30px;
     right: 30px;
     width: 80px;
     height: 80px;
     border-radius: 50%;
     background: linear-gradient(135deg, #f59e0b, #d97706);
     border: 4px solid #fef08a;
     color: white;
     font-size: 1.2rem;
     font-weight: 900;
     box-shadow: 0 6px 20px rgba(217, 119, 6, 0.6);
     cursor: pointer;
     display: flex;
     align-items: center;
     justify-content: center;
     z-index: 20;
   }
   #jump-btn:active {
     transform: scale(0.92);
     box-shadow: 0 2px 10px rgba(217, 119, 6, 0.8);
   }


   /* Guide Box */
   .guide-box {
     position: absolute;
     bottom: 25px;
     left: 50%;
     transform: translateX(-50%);
     background: rgba(15, 23, 42, 0.85);
     border: 1px solid rgba(255, 255, 255, 0.2);
     padding: 10px 22px;
     border-radius: 30px;
     font-size: 0.92rem;
     color: #e2e8f0;
     pointer-events: none;
     text-align: center;
     box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
   }


   /* Customization Modal */
   .modal-overlay {
     position: absolute;
     top: 0; left: 0; width: 100%; height: 100%;
     background: rgba(0, 0, 0, 0.75);
     backdrop-filter: blur(8px);
     display: flex;
     align-items: center;
     justify-content: center;
     z-index: 100;
     opacity: 0;
     pointer-events: none;
     transition: opacity 0.3s ease;
   }
   .modal-overlay.active {
     opacity: 1;
     pointer-events: auto;
   }
   .modal-card {
     background: #1e293b;
     border: 2px solid #3b82f6;
     border-radius: 24px;
     padding: 24px;
     width: 90%;
     max-width: 420px;
     box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
     color: #fff;
   }
   .modal-header {
     display: flex;
     justify-content: space-between;
     align-items: center;
     margin-bottom: 20px;
   }
   .modal-title { font-size: 1.4rem; font-weight: 800; color: #60a5fa; }
   .close-btn {
     background: none; border: none; color: #94a3b8; font-size: 1.5rem; cursor: pointer;
   }
   .section-label {
     font-size: 0.9rem; font-weight: 700; color: #cbd5e1; margin: 12px 0 8px;
   }
   .color-picker-group {
     display: flex; gap: 10px; margin-bottom: 15px;
   }
   .color-opt {
     width: 36px; height: 36px; border-radius: 50%; cursor: pointer; border: 2px solid transparent; transition: transform 0.2s;
   }
   .color-opt:hover { transform: scale(1.15); }
   .color-opt.selected { border-color: #ffffff; box-shadow: 0 0 10px rgba(255,255,255,0.8); }


   .hat-grid {
     display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 20px;
   }
   .hat-btn {
     background: #334155; border: 2px solid #475569; padding: 10px; border-radius: 12px; color: #fff; font-weight: 600; cursor: pointer; text-align: center;
   }
   .hat-btn.active {
     border-color: #38bdf8; background: #0284c7;
   }


   /* Clear Alert */
   #clear-modal {
     position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.8);
     background: linear-gradient(135deg, #1e1b4b, #311b92);
     border: 3px solid #f59e0b;
     padding: 30px; border-radius: 28px; text-align: center; color: white;
     box-shadow: 0 0 50px rgba(245, 158, 11, 0.6);
     z-index: 90; opacity: 0; pointer-events: none; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
   }
   #clear-modal.active {
     opacity: 1; pointer-events: auto; transform: translate(-50%, -50%) scale(1);
   }
 </style>


 <!-- Three.js Library -->
 <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>


 <div id="canvas-container"></div>


 <!-- HUD Interface -->
 <div id="ui-overlay">
   <div class="hud-top">
     <div style="display: flex; gap: 10px;">
       <div class="badge-card">
         <div>
           <div class="badge-title">STAGE</div>
           <div id="stage-val" class="badge-value">1 / 5</div>
         </div>
       </div>
       <div class="badge-card">
         <div>
           <div class="badge-title">TIME</div>
           <div id="timer-val" class="badge-value">00:00</div>
         </div>
       </div>
     </div>


     <div class="btn-group interactive">
       <button class="hud-btn" id="respawn-btn">
         <span>🔄</span> 공중 드롭
       </button>
       <button class="hud-btn" id="custom-btn">
         <span>🎨</span> 꾸미기
       </button>
     </div>
   </div>


   <div class="guide-box">
     🎮 <b>W / ↑</b> : 앞으로 | <b>S / ↓</b> : 뒤로 | <b>A / ←</b> : 왼쪽 | <b>D / →</b> : 오른쪽 | <b>Space</b> : 점프
   </div>


   <button id="jump-btn" class="interactive">JUMP</button>
 </div>


 <!-- Customization Modal -->
 <div id="custom-modal" class="modal-overlay">
   <div class="modal-card">
     <div class="modal-header">
       <div class="modal-title">로블록스 아바타 꾸미기</div>
       <button class="close-btn" id="close-modal">&times;</button>
     </div>


     <div class="section-label">피부 색상</div>
     <div class="color-picker-group" id="skin-colors">
       <div class="color-opt selected" style="background: #fcd34d;" data-color="0xfcd34d"></div>
       <div class="color-opt" style="background: #ffdbac;" data-color="0xffdbac"></div>
       <div class="color-opt" style="background: #e0ac69;" data-color="0xe0ac69"></div>
       <div class="color-opt" style="background: #60a5fa;" data-color="0x60a5fa"></div>
     </div>


     <div class="section-label">상체 의상</div>
     <div class="color-picker-group" id="shirt-colors">
       <div class="color-opt selected" style="background: #2563eb;" data-color="0x2563eb"></div>
       <div class="color-opt" style="background: #dc2626;" data-color="0xdc2626"></div>
       <div class="color-opt" style="background: #16a34a;" data-color="0x16a34a"></div>
       <div class="color-opt" style="background: #9333ea;" data-color="0x9333ea"></div>
       <div class="color-opt" style="background: #f97316;" data-color="0xf97316"></div>
     </div>


     <div class="section-label">모자 액세서리</div>
     <div class="hat-grid">
       <div class="hat-btn active" data-hat="none">없음</div>
       <div class="hat-btn" data-hat="cap">볼캡</div>
       <div class="hat-btn" data-hat="crown">황금 왕관</div>
     </div>
   </div>
 </div>


 <!-- Clear Modal -->
 <div id="clear-modal">
   <h1 style="font-size: 2.2rem; color: #fbbf24; margin-bottom: 10px;">🎉 Victory!</h1>
   <p style="font-size: 1.1rem; color: #cbd5e1; margin-bottom: 20px;">모든 오비 점프맵을 클리어하셨습니다!</p>
   <div style="font-size: 1.5rem; font-weight: 800; color: #38bdf8; margin-bottom: 25px;" id="final-time">클리어 타임: 00:00</div>
   <button class="hud-btn interactive" id="restart-btn" style="margin: 0 auto; padding: 12px 28px; font-size: 1.1rem;">다시 시작하기</button>
 </div>


 <script>
   // --- THREE.JS SCENE & RENDERER SETUP ---
   const container = document.getElementById('canvas-container');
   const scene = new THREE.Scene();
   scene.background = new THREE.Color(0x0a0f24);
   scene.fog = new THREE.FogExp2(0x0a0f24, 0.012);


   const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
   const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
   renderer.setSize(window.innerWidth, window.innerHeight);
   renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
   renderer.shadowMap.enabled = true;
   renderer.shadowMap.type = THREE.PCFSoftShadowMap;
   renderer.toneMapping = THREE.ACESFilmicToneMapping;
   renderer.toneMappingExposure = 1.2;
   container.appendChild(renderer.domElement);


   // --- LIGHTING ---
   const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
   scene.add(ambientLight);


   const dirLight = new THREE.DirectionalLight(0xffffff, 1.2);
   dirLight.position.set(25, 45, 20);
   dirLight.castShadow = true;
   dirLight.shadow.mapSize.width = 2048;
   dirLight.shadow.mapSize.height = 2048;
   dirLight.shadow.camera.near = 0.5;
   dirLight.shadow.camera.far = 180;
   const shadowD = 35;
   dirLight.shadow.camera.left = -shadowD;
   dirLight.shadow.camera.right = shadowD;
   dirLight.shadow.camera.top = shadowD;
   dirLight.shadow.camera.bottom = -shadowD;
   scene.add(dirLight);


   // --- KEYBOARD CONTROLS STATE ---
   const keys = {
     forward: false,
     backward: false,
     left: false,
     right: false
   };


   const state = {
     skinColor: 0xfcd34d,
     shirtColor: 0x2563eb,
     activeHat: 'none',
     currentStage: 1,
     startTime: Date.now(),
     gameEnded: false,
     targetRotationY: 0
   };


   // --- ROBLOX STYLE CHARACTER CREATION ---
   const playerGroup = new THREE.Group();
   const avatarMeshGroup = new THREE.Group();
   playerGroup.add(avatarMeshGroup);
   scene.add(playerGroup);


   let headMesh, torsoMesh, leftArm, rightArm, leftLeg, rightLeg;
   let hatMeshGroup = new THREE.Group();


   const skinMat = new THREE.MeshStandardMaterial({ color: state.skinColor, roughness: 0.4 });
   const shirtMat = new THREE.MeshStandardMaterial({ color: state.shirtColor, roughness: 0.3 });
   const pantMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.4 });


   function buildRobloxCharacter() {
     // Torso (Roblox Blocky Body)
     torsoMesh = new THREE.Mesh(new THREE.BoxGeometry(0.9, 1.0, 0.5), shirtMat);
     torsoMesh.position.y = 0.9;
     torsoMesh.castShadow = true;
     avatarMeshGroup.add(torsoMesh);


     // Head
     headMesh = new THREE.Mesh(new THREE.BoxGeometry(0.65, 0.65, 0.65), skinMat);
     headMesh.position.y = 1.75;
     headMesh.castShadow = true;
     avatarMeshGroup.add(headMesh);


     // Classic Roblox Face Expression (Eyes + Smile)
     const faceCanvas = document.createElement('canvas');
     faceCanvas.width = 128;
     faceCanvas.height = 128;
     const ctx = faceCanvas.getContext('2d');
     ctx.fillStyle = '#fcd34d';
     ctx.fillRect(0, 0, 128, 128);
     // Eyes
     ctx.fillStyle = '#000000';
     ctx.fillRect(30, 38, 16, 26);
     ctx.fillRect(82, 38, 16, 26);
     // Smile
     ctx.beginPath();
     ctx.lineWidth = 8;
     ctx.arc(64, 75, 26, 0.1 * Math.PI, 0.9 * Math.PI, false);
     ctx.stroke();


     const faceTexture = new THREE.CanvasTexture(faceCanvas);
     const faceMat = new THREE.MeshBasicMaterial({ map: faceTexture });
     const facePlane = new THREE.Mesh(new THREE.PlaneGeometry(0.63, 0.63), faceMat);
     facePlane.position.set(0, 1.75, 0.33);
     avatarMeshGroup.add(facePlane);


     // Arms
     const armGeo = new THREE.BoxGeometry(0.38, 0.95, 0.45);
     armGeo.translate(0, -0.4, 0);


     leftArm = new THREE.Mesh(armGeo, skinMat);
     leftArm.position.set(-0.68, 1.35, 0);
     leftArm.castShadow = true;


     rightArm = new THREE.Mesh(armGeo, skinMat);
     rightArm.position.set(0.68, 1.35, 0);
     rightArm.castShadow = true;


     avatarMeshGroup.add(leftArm);
     avatarMeshGroup.add(rightArm);


     // Legs
     const legGeo = new THREE.BoxGeometry(0.42, 0.9, 0.48);
     legGeo.translate(0, -0.4, 0);


     leftLeg = new THREE.Mesh(legGeo, pantMat);
     leftLeg.position.set(-0.24, 0.85, 0);
     leftLeg.castShadow = true;


     rightLeg = new THREE.Mesh(legGeo, pantMat);
     rightLeg.position.set(0.24, 0.85, 0);
     rightLeg.castShadow = true;


     avatarMeshGroup.add(leftLeg);
     avatarMeshGroup.add(rightLeg);


     // Hat Pivot Attachment
     avatarMeshGroup.add(hatMeshGroup);
     hatMeshGroup.position.y = 2.1;
   }
   buildRobloxCharacter();


   // --- HAT ACCESSORIES ---
   function updateHat(hatType) {
     while(hatMeshGroup.children.length > 0) hatMeshGroup.remove(hatMeshGroup.children[0]);
     if (hatType === 'cap') {
       const capMat = new THREE.MeshStandardMaterial({ color: 0xef4444, roughness: 0.3 });
       const capBase = new THREE.Mesh(new THREE.CylinderGeometry(0.36, 0.36, 0.18, 16), capMat);
       const visor = new THREE.Mesh(new THREE.BoxGeometry(0.38, 0.04, 0.32), capMat);
       visor.position.set(0, -0.06, 0.28);
       hatMeshGroup.add(capBase);
       hatMeshGroup.add(visor);
     } else if (hatType === 'crown') {
       const crownMat = new THREE.MeshStandardMaterial({ color: 0xf59e0b, metalness: 0.85, roughness: 0.15 });
       const crown = new THREE.Mesh(new THREE.CylinderGeometry(0.4, 0.32, 0.28, 6), crownMat);
       hatMeshGroup.add(crown);
     }
   }


   // --- PHYSICS & LANDING SYSTEM ---
   const physics = {
     velocity: new THREE.Vector3(),
     isGrounded: false,
     gravity: -28.0,
     jumpForce: 11.5,
     moveSpeed: 9.0,
     checkpoint: new THREE.Vector3(0, 15, 0), // Air spawn default height
     animTime: 0
   };


   function respawnPlayer() {
     playerGroup.position.copy(physics.checkpoint);
     physics.velocity.set(0, 0, 0);
     physics.isGrounded = false;
     createSpawnEffect(playerGroup.position);
   }


   // --- OBBY PLATFORM STAGES ---
   const platforms = [];


   function buildLevel() {
     platforms.forEach(p => scene.remove(p.mesh));
     platforms.length = 0;


     function addPlatform(x, y, z, w, h, d, color = 0x3b82f6, isCheckpoint = false, stageIdx = 1) {
       const geo = new THREE.BoxGeometry(w, h, d);
       const mat = new THREE.MeshStandardMaterial({
         color: color,
         roughness: 0.2,
         metalness: 0.1
       });
       const mesh = new THREE.Mesh(geo, mat);
       mesh.position.set(x, y, z);
       mesh.receiveShadow = true;
       mesh.castShadow = true;
       scene.add(mesh);


       // Neon glossy trim frame
       const edges = new THREE.EdgesGeometry(geo);
       const lineMat = new THREE.LineBasicMaterial({ color: 0xffffff, linewidth: 2 });
       const wireframe = new THREE.LineSegments(edges, lineMat);
       mesh.add(wireframe);


       platforms.push({
         mesh: mesh,
         box: new THREE.Box3(),
         isCheckpoint: isCheckpoint,
         stageIdx: stageIdx
       });


       if (isCheckpoint) {
         const flagPoleMat = new THREE.MeshStandardMaterial({ color: 0xe2e8f0, metalness: 0.8 });
         const flagMat = new THREE.MeshBasicMaterial({ color: 0x22c55e });
         const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 2.2, 8), flagPoleMat);
         pole.position.set(x + w/2 - 0.6, y + h/2 + 1.1, z);
        
         const flag = new THREE.Mesh(new THREE.BoxGeometry(0.8, 0.5, 0.04), flagMat);
         flag.position.set(x + w/2 - 0.2, y + h/2 + 1.8, z);
        
         scene.add(pole);
         scene.add(flag);
       }
     }


     // Stage 1: Spawn Platform & Step Jumps
     addPlatform(0, 0, 0, 8, 1, 8, 0x10b981, true, 1);
     addPlatform(0, 0, -10, 4, 1, 4, 0x3b82f6, false, 1);
     addPlatform(-3.5, 1, -18, 3, 1, 3, 0x3b82f6, false, 1);
     addPlatform(3.5, 2, -26, 3, 1, 3, 0x3b82f6, false, 1);


     // Stage 2: Checkpoint & Thin Beams
     addPlatform(0, 3, -36, 6, 1, 6, 0x10b981, true, 2);
     addPlatform(-4, 4, -46, 2.2, 1, 2.2, 0x8b5cf6, false, 2);
     addPlatform(0, 5, -54, 2.2, 1, 2.2, 0x8b5cf6, false, 2);
     addPlatform(4, 6, -62, 2.2, 1, 2.2, 0x8b5cf6, false, 2);


     // Stage 3: High Rises
     addPlatform(0, 7, -72, 6, 1, 6, 0x10b981, true, 3);
     addPlatform(-3.5, 8.5, -82, 2, 1, 2, 0xec4899, false, 3);
     addPlatform(3.5, 10, -90, 2, 1, 2, 0xec4899, false, 3);
     addPlatform(-2, 11.5, -98, 2, 1, 2, 0xec4899, false, 3);


     // Stage 4: Long Leap
     addPlatform(0, 13, -108, 6, 1, 6, 0x10b981, true, 4);
     addPlatform(0, 14, -120, 2.8, 1, 2.8, 0xf59e0b, false, 4);
     addPlatform(0, 15, -132, 2.8, 1, 2.8, 0xf59e0b, false, 4);


     // Stage 5: Final Golden Stage
     addPlatform(0, 16, -146, 10, 1, 10, 0xeab308, true, 5);
   }
   buildLevel();


   // Shockwave Dust Effect
   function createLandingEffect(pos) {
     const ringGeo = new THREE.RingGeometry(0.2, 0.9, 16);
     const ringMat = new THREE.MeshBasicMaterial({ color: 0xffffff, side: THREE.DoubleSide, transparent: true, opacity: 0.85 });
     const ring = new THREE.Mesh(ringGeo, ringMat);
     ring.rotation.x = Math.PI / 2;
     ring.position.set(pos.x, pos.y + 0.05, pos.z);
     scene.add(ring);


     let scale = 1;
     const anim = setInterval(() => {
       scale += 0.25;
       ring.scale.set(scale, scale, scale);
       ringMat.opacity -= 0.12;
       if (ringMat.opacity <= 0) {
         clearInterval(anim);
         scene.remove(ring);
       }
     }, 30);
   }


   function createSpawnEffect(pos) {
     const colGeo = new THREE.CylinderGeometry(0.9, 0.9, 12, 16);
     const colMat = new THREE.MeshBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.45 });
     const col = new THREE.Mesh(colGeo, colMat);
     col.position.set(pos.x, pos.y + 6, pos.z);
     scene.add(col);


     setTimeout(() => scene.remove(col), 400);
   }


   // Initial Drop Start
   respawnPlayer();


   // --- KEYBOARD & CONTROLS ---
   window.addEventListener('keydown', (e) => {
     if (e.key === 'w' || e.key === 'W' || e.key === 'ArrowUp') keys.forward = true;
     if (e.key === 's' || e.key === 'S' || e.key === 'ArrowDown') keys.backward = true;
     if (e.key === 'a' || e.key === 'A' || e.key === 'ArrowLeft') keys.left = true;
     if (e.key === 'd' || e.key === 'D' || e.key === 'ArrowRight') keys.right = true;
     if (e.key === ' ' || e.key === 'Spacebar') triggerJump();
   });


   window.addEventListener('keyup', (e) => {
     if (e.key === 'w' || e.key === 'W' || e.key === 'ArrowUp') keys.forward = false;
     if (e.key === 's' || e.key === 'S' || e.key === 'ArrowDown') keys.backward = false;
     if (e.key === 'a' || e.key === 'A' || e.key === 'ArrowLeft') keys.left = false;
     if (e.key === 'd' || e.key === 'D' || e.key === 'ArrowRight') keys.right = false;
   });


   function triggerJump() {
     if (physics.isGrounded) {
       physics.velocity.y = physics.jumpForce;
       physics.isGrounded = false;
     }
   }


   document.getElementById('jump-btn').addEventListener('click', triggerJump);
   document.getElementById('respawn-btn').addEventListener('click', respawnPlayer);


   // Customization Modal Handlers
   const customModal = document.getElementById('custom-modal');
   document.getElementById('custom-btn').addEventListener('click', () => customModal.classList.add('active'));
   document.getElementById('close-modal').addEventListener('click', () => customModal.classList.remove('active'));


   document.querySelectorAll('#skin-colors .color-opt').forEach(opt => {
     opt.addEventListener('click', () => {
       document.querySelectorAll('#skin-colors .color-opt').forEach(o => o.classList.remove('selected'));
       opt.classList.add('selected');
       skinMat.color.setHex(parseInt(opt.dataset.color));
     });
   });


   document.querySelectorAll('#shirt-colors .color-opt').forEach(opt => {
     opt.addEventListener('click', () => {
       document.querySelectorAll('#shirt-colors .color-opt').forEach(o => o.classList.remove('selected'));
       opt.classList.add('selected');
       shirtMat.color.setHex(parseInt(opt.dataset.color));
     });
   });


   document.querySelectorAll('.hat-btn').forEach(btn => {
     btn.addEventListener('click', () => {
       document.querySelectorAll('.hat-btn').forEach(b => b.classList.remove('active'));
       btn.classList.add('active');
       updateHat(btn.dataset.hat);
     });
   });


   // Angle Interpolation helper
   function lerpAngle(start, end, amount) {
     let difference = end - start;
     while (difference < -Math.PI) difference += Math.PI * 2;
     while (difference > Math.PI) difference -= Math.PI * 2;
     return start + difference * amount;
   }


   // --- GAME LOOP & ANIMATION ---
   const clock = new THREE.Clock();


   function animate() {
     requestAnimationFrame(animate);
     const delta = Math.min(clock.getDelta(), 0.1);


     if (!state.gameEnded) {
       // Timer HUD
       const elapsed = Math.floor((Date.now() - state.startTime) / 1000);
       const mins = String(Math.floor(elapsed / 60)).padStart(2, '0');
       const secs = String(elapsed % 60).padStart(2, '0');
       document.getElementById('timer-val').innerText = `${mins}:${secs}`;


       // Direction Vector Calculation
       let moveX = 0;
       let moveZ = 0;


       if (keys.left) moveX -= 1;
       if (keys.right) moveX += 1;
       if (keys.forward) moveZ -= 1;
       if (keys.backward) moveZ += 1;


       const isMoving = moveX !== 0 || moveZ !== 0;


       if (isMoving) {
         // Calculate Target Rotation Angle (Face movement direction)
         state.targetRotationY = Math.atan2(moveX, moveZ);
        
         // Smooth Character Rotation Lerp
         avatarMeshGroup.rotation.y = lerpAngle(avatarMeshGroup.rotation.y, state.targetRotationY, 14 * delta);


         // Velocity
         physics.velocity.x = moveX * physics.moveSpeed;
         physics.velocity.z = moveZ * physics.moveSpeed;


         // Walking Animation Swing
         physics.animTime += delta * 12;
         const swing = Math.sin(physics.animTime) * 0.65;
         leftArm.rotation.x = swing;
         rightArm.rotation.x = -swing;
         leftLeg.rotation.x = -swing;
         rightLeg.rotation.x = swing;
       } else {
         physics.velocity.x = 0;
         physics.velocity.z = 0;


         // Reset Limb Rotations Smoothly
         leftArm.rotation.x *= 0.8;
         rightArm.rotation.x *= 0.8;
         leftLeg.rotation.x *= 0.8;
         rightLeg.rotation.x *= 0.8;
       }


       // Apply Gravity
       physics.velocity.y += physics.gravity * delta;


       // Position Updates
       playerGroup.position.x += physics.velocity.x * delta;
       playerGroup.position.y += physics.velocity.y * delta;
       playerGroup.position.z += physics.velocity.z * delta;


       // Squash & Stretch Animation for Jump/Fall
       if (!physics.isGrounded) {
         if (physics.velocity.y > 0) {
           avatarMeshGroup.scale.set(0.85, 1.18, 0.85); // Stretching up when jumping
         } else {
           avatarMeshGroup.scale.set(0.92, 1.1, 0.92); // Stretching down when falling
         }
       } else {
         avatarMeshGroup.scale.lerp(new THREE.Vector3(1, 1, 1), 15 * delta);
       }


       // Collision Box Detection
       const playerBox = new THREE.Box3().setFromCenterAndSize(
         new THREE.Vector3(playerGroup.position.x, playerGroup.position.y + 0.9, playerGroup.position.z),
         new THREE.Vector3(0.75, 1.8, 0.75)
       );


       let landed = false;
       platforms.forEach(plat => {
         plat.box.setFromObject(plat.mesh);


         if (playerBox.intersectsBox(plat.box)) {
           const platTop = plat.box.max.y;
           // Floor landing condition
           if (physics.velocity.y <= 0 && playerGroup.position.y >= platTop - 0.45) {
             if (!physics.isGrounded) {
               // Dust Landing Shockwave Effect
               createLandingEffect(playerGroup.position);
             }
             playerGroup.position.y = platTop; // Stop at platform surface
             physics.velocity.y = 0;
             physics.isGrounded = true;
             landed = true;


             // Checkpoint Check
             if (plat.isCheckpoint) {
               physics.checkpoint.set(plat.mesh.position.x, plat.mesh.position.y + 12, plat.mesh.position.z);
               state.currentStage = plat.stageIdx;
               document.getElementById('stage-val').innerText = `${state.currentStage} / 5`;


               if (plat.stageIdx === 5 && !state.gameEnded) {
                 state.gameEnded = true;
                 document.getElementById('final-time').innerText = `클리어 타임: ${mins}:${secs}`;
                 document.getElementById('clear-modal').classList.add('active');
               }
             }
           }
         }
       });


       if (!landed) {
         physics.isGrounded = false;
       }


       // Pit Fall Check
       if (playerGroup.position.y < -15) {
         respawnPlayer();
       }


       // Camera Smooth Follow
       const targetCamPos = new THREE.Vector3(
         playerGroup.position.x,
         playerGroup.position.y + 5.5,
         playerGroup.position.z + 10.0
       );
       camera.position.lerp(targetCamPos, 0.12);
       camera.lookAt(playerGroup.position.x, playerGroup.position.y + 1.2, playerGroup.position.z);
     }


     renderer.render(scene, camera);
   }


   // Window Resize Handler
   window.addEventListener('resize', () => {
     camera.aspect = window.innerWidth / window.innerHeight;
     camera.updateProjectionMatrix();
     renderer.setSize(window.innerWidth, window.innerHeight);
   });


   document.getElementById('restart-btn').addEventListener('click', () => {
     document.getElementById('clear-modal').classList.remove('active');
     state.gameEnded = false;
     state.startTime = Date.now();
     physics.checkpoint.set(0, 15, 0);
     respawnPlayer();
   });


   animate();
 </script>
</body>
</html>
